def find_files(directory="."):
    folder = Path(directory)
    files = sorted(list(folder.glob("*.xml")) + list(folder.glob("*.dsx")))
    return files


def show_menu(files):
    os.system('cls' if os.name == 'nt' else 'clear')
    print("=" * 70)
    print("   DATASTAGE XML COLUMN LINEAGE EXTRACTOR")
    print("=" * 70)
    print(f"\n   Found {len(files)} file(s) in current directory:\n")
    print(f"   {'#':<4} {'File Name':<50} {'Size'}")
    print(f"   {'-'*4} {'-'*50} {'-'*10}")
    for i, f in enumerate(files, 1):
        size = f.stat().st_size
        size_str = f"{size:,} bytes" if size < 1024*1024 else f"{size/(1024*1024):.1f} MB"
        print(f"   {i:<4} {f.name:<50} {size_str}")
    print(f"\n   {'0':<4} Exit")
    print("=" * 70)


def get_user_choice(max_num):
    while True:
        try:
            choice = input(f"\n   ➤  Enter the number of the file to process: ").strip()
            if not choice:
                continue
            num = int(choice)
            if num == 0:
                print("\n   Exiting... Goodbye!")
                sys.exit(0)
            if 1 <= num <= max_num:
                return num
            print(f"   ⚠️  Please enter a number between 1 and {max_num}, or 0 to exit.")
        except ValueError:
            print("   ⚠️  Invalid input. Please enter a valid number.")


def process_selected_file(xml_path):
    print(f"\n   📄 Reading file: {xml_path.name}")
    print(f"   {'─'*60}")

    try:
        parser = DataStageParser(str(xml_path))
    except Exception as e:
        print(f"\n   ❌ ERROR: Failed to parse file: {e}")
        import traceback
        traceback.print_exc()
        return False

    print(f"   ✓ Stages found:      {len(parser.stages)}")
    print(f"   ✓ Links found:       {len(parser.links)}")
    sources = parser.get_sources()
    targets = parser.get_targets()
    print(f"   ✓ Source stages:     {[s['Properties'].get('Name') for s in sources]}")
    print(f"   ✓ Target stages:     {[s['Properties'].get('Name') for s in targets]}")

    if len(parser.stages) == 0:
        print("\n   ⚠️  No stages found! The file may not be a valid DataStage job export.")
        return False

    print(f"\n   🔍 Tracing column lineage...")
    tracer = LineageTracer(parser)
    rows = tracer.build()

    base_name = xml_path.stem
    output_path = xml_path.parent / f"{base_name}_lineage.xlsx"

    write_excel(rows, str(output_path))
    return True


def main():
    try:
        import openpyxl
    except ImportError:
        print("\n" + "="*60)
        print("ERROR: openpyxl is required.")
        print("Install it using:  pip install pandas openpyxl")
        print("="*60)
        input("\nPress Enter to exit...")
        sys.exit(1)

    files = find_files()
    if not files:
        print("\n" + "="*60)
        print("No .xml or .dsx files found in the current directory.")
        print(f"Current directory: {os.path.abspath('.')}")
        print("="*60)
        print("\nPlease place your DataStage files in this folder and run again.")
        input("\nPress Enter to exit...")
        sys.exit(1)

    while True:
        show_menu(files)
        choice = get_user_choice(len(files))
        selected_file = files[choice - 1]

        success = process_selected_file(selected_file)

        if success:
            print("   What would you like to do next?")
            print("   1. Process another file")
            print("   2. Exit")
            next_action = input("\n   ➤  Enter choice (1 or 2): ").strip()
            if next_action == "2":
                print("\n   Exiting... Goodbye!")
                break
        else:
            input("\n   Press Enter to return to menu...")


if __name__ == "__main__":
    main()
