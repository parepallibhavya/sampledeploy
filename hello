def clean_stage_type(raw: str) -> str:
    """Remove 'Px' prefix from StageType values (e.g., PxTransformer -> Transformer)."""
    if raw and raw.startswith("Px"):
        return raw[2:]
    return raw or "Unknown"


def format_dtype(sql_type, precision, scale) -> str:
    """Pretty-print data type with precision and scale."""
    if not sql_type:
        return ""
    p = str(precision).strip() if precision else ""
    s = str(scale).strip() if scale else ""
    if p and s:
        return f"{sql_type}({p},{s})"
    elif p:
        return f"{sql_type}({p})"
    return sql_type


def ci_match(name1: str, name2: str) -> bool:
    """Case-insensitive string comparison for column names."""
    return str(name1).strip().lower() == str(name2).strip().lower()


def clear_screen():
    """Clear the console screen (cross-platform)."""
    os.system('cls' if os.name == 'nt' else 'clear')


