import os
import glob
import pathlib
import xml.etree.ElementTree as ET
from typing import Dict, List, Optional

import pandas as pd


BASE_DIR = r"C:\DataStage\xml"
OUTPUT_DIR = r"C:\DataStage\output"


# ============================================================
# BASIC XML HELPERS
# ============================================================

def get_text(element: Optional[ET.Element]) -> str:
    """Return stripped XML text."""
    if element is None or element.text is None:
        return ""

    return element.text.strip()


def get_property(parent: ET.Element, property_name: str) -> str:
    """Read <Property Name='...'>...</Property>."""

    element = parent.find(
        f".//Property[@Name='{property_name}']"
    )

    return get_text(element)


# ============================================================
# DATA TYPE
# ============================================================

def get_data_type(sql_type: str) -> str:

    sql_type = (sql_type or "").strip()

    type_map = {
        "1": "Char",
        "2": "VarChar",
        "3": "LongVarChar",
        "4": "Integer",
        "5": "SmallInt",
        "6": "BigInt",
        "7": "Decimal",
        "8": "Float",
        "9": "Double",
        "10": "Date",
        "11": "Time",
        "12": "Timestamp",
    }

    return type_map.get(
        sql_type,
        sql_type if sql_type else "N/A"
    )


# ============================================================
# BUILD LINK -> PARTNER MAP
# ============================================================

def build_link_partner_map(
    root: ET.Element
) -> Dict[str, str]:

    mapping = {}

    for rec in root.findall(".//Record"):

        rec_type = rec.get("Type", "")

        if rec_type not in (
            "CustomOutput",
            "TrxOutput"
        ):
            continue

        link_name = get_property(
            rec,
            "Name"
        )

        partner = get_property(
            rec,
            "Partner"
        )

        if link_name and partner:

            mapping[link_name] = partner

    return mapping


# ============================================================
# BUILD TABLE IDENTIFIER MAP
# ============================================================

def build_table_identifier_map(
    xml_path: str
) -> Dict[str, str]:
    """
    Link Name -> Record Identifier

    Uses the existing logic from your code.
    """

    root = ET.parse(
        xml_path
    ).getroot()

    mapping = {}

    for rec in root.findall(".//Record"):

        rec_type = rec.get("Type", "")

        if rec_type not in (
            "CustomOutput",
            "TrxOutput"
        ):
            continue

        identifier = (
            rec.get("Identifier", "") or ""
        ).strip()

        name = get_property(
            rec,
            "Name"
        )

        if (
            name
            and identifier
            and name not in mapping
        ):
            mapping[name] = identifier

    return mapping


# ============================================================
# SOURCE COLUMN PARSER
# ============================================================

def parse_source_column(
    source_col_raw: str,
    partner: str
):
    """
    Extract source link and source column.

    Example:

        SOURCE_LINK.CUSTOMER_ID

    becomes:

        source_link   = SOURCE_LINK
        source_column = CUSTOMER_ID

    If SourceColumn contains only:

        CUSTOMER_ID

    then Partner is used as the source link.
    """

    source_col_raw = (
        source_col_raw or ""
    ).strip()

    partner = (
        partner or ""
    ).strip()

    if not source_col_raw:

        return (
            partner,
            ""
        )

    if "." in source_col_raw:

        source_link, source_column = (
            source_col_raw.rsplit(".", 1)
        )

        return (
            source_link.strip(),
            source_column.strip()
        )

    return (
        partner,
        source_col_raw
    )


# ============================================================
# CORRECT SOURCE -> TARGET PARSER
# ============================================================

def parse_datastage_xml(
    xml_path: str,
    include_source: bool = True
) -> pd.DataFrame:

    root = ET.parse(
        xml_path
    ).getroot()

    # --------------------------------------------------------
    # Existing Partner logic
    # --------------------------------------------------------

    link_to_partner = (
        build_link_partner_map(root)
    )

    # --------------------------------------------------------
    # Existing Identifier logic
    # --------------------------------------------------------

    table_identifier_map = (
        build_table_identifier_map(
            xml_path
        )
    )

    rows = []

    # ========================================================
    # PROCESS TARGET / OUTPUT RECORDS
    # ========================================================

    for rec in root.findall(".//Record"):

        rec_type = rec.get(
            "Type",
            ""
        )

        if rec_type not in (
            "CustomOutput",
            "TrxOutput"
        ):
            continue

        # ----------------------------------------------------
        # TARGET LINK
        # ----------------------------------------------------

        target_link = get_property(
            rec,
            "Name"
        )

        if not target_link:
            continue

        # ----------------------------------------------------
        # TARGET TABLE
        #
        # Preserve your existing idea:
        # table hint / link name / stage identifier
        # ----------------------------------------------------

        target_table = (
            get_property(
                rec,
                "TableHint"
            )
            or get_property(
                rec,
                "Table"
            )
            or target_link
        )

        # ----------------------------------------------------
        # TARGET IDENTIFIER
        # ----------------------------------------------------

        target_identifier = (
            rec.get(
                "Identifier",
                ""
            ) or ""
        ).strip()

        # ----------------------------------------------------
        # PARTNER
        # ----------------------------------------------------

        partner_val = link_to_partner.get(
            target_link,
            ""
        )

        # ====================================================
        # OUTPUT COLUMNS
        # ====================================================

        output_columns = rec.findall(
            ".//Collection[@Type='OutputColumn']/SubRecord"
        )

        for col in output_columns:

            # ------------------------------------------------
            # TARGET COLUMN
            # ------------------------------------------------

            target_column = get_property(
                col,
                "Name"
            )

            if not target_column:
                continue

            # ------------------------------------------------
            # SOURCE COLUMN
            # ------------------------------------------------

            source_col_raw = get_property(
                col,
                "SourceColumn"
            )

            # ------------------------------------------------
            # DATA TYPE
            # ------------------------------------------------

            sql_type_raw = get_property(
                col,
                "SqlType"
            )

            data_type = get_data_type(
                sql_type_raw
            )

            # =================================================
            # THIS IS THE IMPORTANT PART
            # =================================================

            source_link, source_column = (
                parse_source_column(
                    source_col_raw,
                    partner_val
                )
            )

            # -------------------------------------------------
            # SOURCE TABLE
            #
            # First preference:
            # source link
            #
            # If the source link exists in the identifier map,
            # preserve the corresponding identifier information.
            # -------------------------------------------------

            source_table = (
                source_link
                if source_link
                else "N/A"
            )

            source_identifier = (
                table_identifier_map.get(
                    source_link,
                    "N/A"
                )
            )

            # =================================================
            # CREATE ONE SOURCE -> TARGET ROW
            # =================================================

            rows.append({

                # SOURCE
                "Source Table":
                    source_table,

                "Source Column":
                    source_column
                    if source_column
                    else "N/A",

                # TARGET
                "Target Table":
                    target_table
                    if target_table
                    else "N/A",

                "Target Column":
                    target_column
                    if target_column
                    else "N/A",

                # TYPE
                "Data Type":
                    data_type,

                # LINK INFORMATION
                "Source Link":
                    source_link
                    if source_link
                    else "N/A",

                "Target Link":
                    target_link,

                "Partner":
                    partner_val
                    if partner_val
                    else "N/A",

                # IDENTIFIERS
                "Source Identifier":
                    source_identifier,

                "Target Identifier":
                    target_identifier
                    if target_identifier
                    else "N/A",

                # RAW VALUE - VERY USEFUL FOR DEBUGGING
                "Source Column Raw":
                    source_col_raw
                    if source_col_raw
                    else "N/A",
            })

    # ========================================================
    # DATAFRAME
    # ========================================================

    columns = [
        "Source Table",
        "Source Column",
        "Target Table",
        "Target Column",
        "Data Type",
        "Source Link",
        "Target Link",
        "Partner",
        "Source Identifier",
        "Target Identifier",
        "Source Column Raw",
    ]

    if not rows:

        return pd.DataFrame(
            columns=columns
        )

    df = pd.DataFrame(
        rows
    )

    # --------------------------------------------------------
    # Remove duplicate mappings
    # --------------------------------------------------------

    df = df.drop_duplicates(
        subset=[
            "Source Table",
            "Source Column",
            "Target Table",
            "Target Column",
            "Data Type",
        ]
    )

    df = df.reset_index(
        drop=True
    )

    return df


# ============================================================
# WRITE EXCEL
# ============================================================

def write_excel(
    df: pd.DataFrame,
    xml_file: str
):

    os.makedirs(
        OUTPUT_DIR,
        exist_ok=True
    )

    output_path = os.path.join(
        OUTPUT_DIR,
        f"{pathlib.Path(xml_file).stem}_report.xlsx"
    )

    with pd.ExcelWriter(
        output_path,
        engine="openpyxl"
    ) as writer:

        df.to_excel(
            writer,
            sheet_name="Report",
            index=False
        )

        worksheet = writer.sheets[
            "Report"
        ]

        # Auto column width
        for column_cells in worksheet.columns:

            max_length = 0

            column_letter = (
                column_cells[0]
                .column_letter
            )

            for cell in column_cells:

                value = str(
                    cell.value
                    if cell.value is not None
                    else ""
                )

                max_length = max(
                    max_length,
                    len(value)
                )

            worksheet.column_dimensions[
                column_letter
            ].width = min(
                max_length + 2,
                50
            )

    return output_path


# ============================================================
# LIST XML FILES
# ============================================================

def list_xml_files() -> List[str]:

    pattern = os.path.join(
        BASE_DIR,
        "*.xml"
    )

    return [
        os.path.basename(path)
        for path in glob.glob(pattern)
    ]


# ============================================================
# MAIN
# ============================================================

def main():

    xml_files = list_xml_files()

    if not xml_files:

        print(
            "No .xml files found in:",
            BASE_DIR
        )

        return

    print(
        "\n=== Available XML job files ==="
    )

    for i, filename in enumerate(
        xml_files,
        1
    ):

        print(
            f"{i:3d}. {filename}"
        )

    try:

        choice = int(
            input(
                "\nSelect a file by number: "
            ).strip()
        )

        selected = xml_files[
            choice - 1
        ]

    except (
        ValueError,
        IndexError
    ):

        print(
            "Invalid choice. Exiting."
        )

        return

    xml_path = os.path.join(
        BASE_DIR,
        selected
    )

    print(
        f"\nParsing {selected}..."
    )

    df = parse_datastage_xml(
        xml_path
    )

    if df.empty:

        print(
            "\nNo source-to-target mappings found."
        )

        return

    output_path = write_excel(
        df,
        selected
    )

    print(
        f"\nReport saved to: {output_path}"
    )

    print(
        f"Rows written: {len(df)}"
    )

    print(
        "\nFirst 10 mappings:"
    )

    print(
        df.head(10).to_string(
            index=False
        )
    )


if __name__ == "__main__":
    main()
