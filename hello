class DataStageParser:
    """
    Parses a DataStage XML/DSX file into stages, links, and builds the flow graph.
    """

    def __init__(self, xml_path: str):
        self.xml_path = xml_path
        self.tree = ET.parse(xml_path)
        self.root = self.tree.getroot()
        self.stages = []          # List of all stage dictionaries
        self.links = []           # List of all link dictionaries
        self.stage_by_name = {}   # Map: stage_name -> stage dict
        self.link_by_name = {}    # Map: link_name -> link dict
        self.incoming = defaultdict(list)   # stage_name -> [incoming links]
        self.outgoing = defaultdict(list)   # stage_name -> [outgoing links]
        self._parse()

    def _extract_record(self, elem) -> dict:
        """Extract Properties and Collections from any SubRecord XML element."""
        data = {"Properties": {}, "Collections": defaultdict(list)}
        for prop in elem.findall("Property"):
            name = prop.get("Name")
            val = prop.text
            if name:
                data["Properties"][name] = val
        for coll in elem.findall("Collection"):
            cname = coll.get("Name")
            if not cname:
                continue
            for sub in coll.findall("SubRecord"):
                item = {}
                for p in sub.findall("Property"):
                    item[p.get("Name")] = p.text
                data["Collections"][cname].append(item)
        return data

    def _parse(self):
        """Parse Job, Stages, and Links from the XML."""
        job = self.root.find(".//Job")
        if job is None:
            job = self.root

        # Parse all stages
        stages_rec = job.find('.//Record[@Identifier="Stages"]')
        if stages_rec is not None:
            for stage_sub in stages_rec.findall('SubRecord[@Identifier="Stage"]'):
                stage = self._extract_record(stage_sub)
                stage["_raw_type"] = stage["Properties"].get("StageType", "")
                stage["CleanStageType"] = clean_stage_type(stage["_raw_type"])
                self.stages.append(stage)
                name = stage["Properties"].get("StageName")
                if name:
                    self.stage_by_name[name] = stage

        # Parse all links
        links_rec = job.find('.//Record[@Identifier="Links"]')
        if links_rec is not None:
            for link_sub in links_rec.findall('SubRecord[@Identifier="Link"]'):
                link = self._extract_record(link_sub)
                self.links.append(link)
                lname = link["Properties"].get("LinkName")
                if lname:
                    self.link_by_name[lname] = link
                from_stage = link["Properties"].get("FromStage")
                to_stage = link["Properties"].get("ToStage")
                if from_stage:
                    self.outgoing[from_stage].append(link)
                if to_stage:
                    self.incoming[to_stage].append(link)

    def get_sources(self):
        """Return stages with no incoming links (Extract / Source stages)."""
        return [s for s in self.stages if not self.incoming.get(s["Properties"].get("StageName"))]

    def get_targets(self):
        """Return stages with no outgoing links (Load / Target stages)."""
        return [s for s in self.stages if not self.outgoing.get(s["Properties"].get("StageName"))]


