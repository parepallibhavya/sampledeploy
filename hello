# ------------------ FILE HANDLING ------------------

def list_xml_files():
    return glob.glob(os.path.join(CWD, "*.xml"))

def read_xml(file_path):
    for encoding in ['utf-8', 'utf-8-sig', 'cp1252', 'latin1']:
        try:
            with open(file_path, 'r', encoding=encoding, errors="ignore") as f:
                return f.read()
        except:
            continue
    raise OSError("Failed to read XML")

# ------------------ PARSE LLM OUTPUT ------------------

def parse_llm_table(report):
    columns = [
        "Sr.No", "Source Column Name", "Source", "Source Data Type",
        "Join Logic", "Extraction Logic",
        "Target Column Name", "Target Data Type", "Target"
    ]

    # Markdown table parsing
    rows = re.findall(
        r"\|\s*(.*?)\s*\|\s*(.*?)\s*\|\s*(.*?)\s*\|\s*(.*?)\s*\|\s*(.*?)\s*\|\s*(.*?)\s*\|\s*(.*?)\s*\|\s*(.*?)\s*\|\s*(.*?)\s*\|",
        report,
        re.DOTALL
    )

    if rows:
        df = pd.DataFrame(rows, columns=columns)
        df = df.fillna("")

        df["Join Logic"] = df["Join Logic"].replace(
            ['', 'N/A', 'NA', 'nan'],
            'No explicit join detected'
        )

        return df

    # fallback
    df = pd.DataFrame(columns=columns)
    df.loc[0] = [
        "1", "Parse failed", "N/A", "N/A",
        "Check XML structure",
        report[:200],
        "N/A", "N/A", "N/A"
    ]
    return df

# ------------------ LLM PROMPT ------------------

def generate_report(xml_content, xml_filename):

    prompt = f"""
Act as a DataStage ETL analyzer.

Parse the XML and extract FULL column lineage.

STEPS:

1. Parse all stages.
2. Parse all links (From → To).

3. Identify SOURCE stages:
   - Stage NEVER appears in any "To"
   - AND appears in at least one "From"

4. Trace flow:
   Source → Transformer/Join → Target

5. Extract:

Source Stage
Source Column
Source Type

Join Logic (lookup, inner, left, etc.)
Extraction Logic (filters, WHERE, transformer derivations)

Target Column
Target Type
Target Stage

6. Detect logic from:
- PxLookup
- TransformerStage (Derivations)
- SQL queries
- Filters (WHERE / pWhere)

7. Output STRICT markdown table with EXACT 9 columns:

| Sr.No | Source Column Name | Source | Source Data Type | Join Logic | Extraction Logic | Target Column Name | Target Data Type | Target |

Rules:
- No extra text
- No explanations
- No missing columns
- No duplicate rows

XML:
{xml_content[:12000]}
"""

    try:
        response = client.chat.completions.create(
            model="mistral-medium-2508",
            messages=[{"role": "user", "content": prompt}],
            temperature=0.05,
            max_tokens=4000
        )

        return response.choices[0].message.content

    except Exception as e:
        return f"ERROR: {str(e)}"

# ------------------ MAIN ------------------

def main():
    os.makedirs(OUTPUT_DIR, exist_ok=True)

    xml_files = list_xml_files()

    if not xml_files:
        print("No XML files found.")
        return

    print("XML Files:")
    for i, f in enumerate(xml_files, 1):
        print(f"{i}. {os.path.basename(f)}")

    try:
        choice = int(input("Select file: ")) - 1
        selected = xml_files[choice]
    except:
        print("Invalid selection")
        return

    print(f"\nProcessing: {selected}")

    try:
        xml_content = read_xml(selected)
    except Exception as e:
        print(f"Read error: {e}")
        return

    report = generate_report(xml_content, selected)

    df = parse_llm_table(report)

    output_file = os.path.join(
        OUTPUT_DIR,
        os.path.splitext(os.path.basename(selected))[0] + "_report.xlsx"
    )

    df.to_excel(output_file, index=False)

    print(f"\nSaved: {output_file}")
    print(df.head())


if __name__ == "__main__":
    main()
